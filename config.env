# Configuration for map_pao1_with_decoys.sh
# Copy this file for each project/run and edit the paths below.

# Directory containing input single-end FASTQ files. Files matching FASTQ_GLOB are processed.
FASTQ_DIR="."
FASTQ_GLOB="*.fastq"

# Directory where pipeline outputs are written. Use "." to write beside the FASTQ files.
OUTPUT_DIR="."

# Bowtie2 index basename for the decoy/pangenome reference.
# Example: /path/to/referencegenomes/Gina_Pangenome
DECOY_BOWTIE2_INDEX="/path/to/referencegenomes/Gina_Pangenome"

# Bowtie2 index basename for the Pseudomonas aeruginosa PAO1 reference.
# Example: /path/to/referencegenomes/Pseudomonas_aeruginosa_PAO1_107
PAO1_BOWTIE2_INDEX="/path/to/referencegenomes/Pseudomonas_aeruginosa_PAO1_107"

# PAO1 gene annotation used by featureCounts.
# Example: /path/to/referencegenomes/Pseudomonas_aeruginosa_PAO1_107.gff3
PAO1_GFF3="/path/to/referencegenomes/Pseudomonas_aeruginosa_PAO1_107.gff3"

# Adapter and trimming settings.
ADAPTER_SEQUENCE="AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC"
MIN_READ_LENGTH="22"

# Thread counts for pipeline steps.
CUTADAPT_THREADS="40"
BOWTIE2_DECOY_THREADS="24"
BOWTIE2_PAO1_THREADS="16"
FEATURECOUNTS_THREADS="24"
SAMTOOLS_THREADS="16"

# Path to the summary conversion script. Relative paths are resolved from this repository.
CSV_CONVERSION_SCRIPT="pao1_with_decoys_csvConversion.py"
