# Configuration for map_bacteria_with_decoys.sh
# Copy this file for each project/run and edit the paths below.

# Directory containing input FASTQ files. Files matching FASTQ_GLOB are processed.
FASTQ_DIR="."
FASTQ_GLOB="*.fastq*"

# Input layout: "single" processes each matching file independently; "paired"
# matches files named <sample>_R1.fastq[.gz] and <sample>_R2.fastq[.gz],
# including matching suffixes such as <sample>_R1_001 and <sample>_R2_001.
READ_LAYOUT="single"

# Directory where pipeline outputs are written. Use "." to write beside the FASTQ files.
OUTPUT_DIR="."

# Set to true to run only a random subset of up to SAMPLE_SIZE reads per FASTQ.
# Use the same seed to reproduce a sample, or change it to draw another subset.
SAMPLE_READS="false"
SAMPLE_SIZE="5000"
SAMPLE_SEED="1"

# Reference folders are searched recursively. FASTA, GFF, and GenBank files
# may be gzip-compressed; no shared filename root is required.
DECOY_REFERENCE_DIR="/path/to/referencegenomes/decoy"
BACTERIA_REFERENCE_DIR="/path/to/referencegenomes/PAO1"
# Point at human or mouse (containing *_RNA and *_DNA), or leave empty.
HOST_REFERENCE_DIR=""

# Generated FASTA, normalized annotations and Bowtie2 indices are cached here.
# Leave empty to use OUTPUT_DIR/.reference_cache. References are never modified.
REFERENCE_CACHE_DIR=""

# Strand of read 1 relative to the annotated transcript. Use reverse for a
# reverse-stranded library, or unstranded when the library is not directional.
COUNT_STRAND="forward"

# Adapter and trimming settings. ADAPTER_SINGLE is used for single-end reads;
# ADAPTER_R1 and ADAPTER_R2 are used for the respective paired-end mates.
ADAPTER_SINGLE="AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC"
ADAPTER_R1="CTGTCTCTTATACACATCT"
ADAPTER_R2="CTGTCTCTTATACACATCT"
MIN_READ_LENGTH="22"

# Number of threads used by every multithreaded pipeline step.
THREADS="16"

# Normalized bacterial feature-position profiles use this many 5'-to-3' bins.
# Features with fewer assigned reads remain in detailed outputs but do not
# contribute to aggregate metagene profiles.
GENE_POSITION_BINS="100"
METAGENE_MIN_FEATURE_READS="10"

# Path to the summary conversion script. Relative paths are resolved from this repository.
CSV_CONVERSION_SCRIPT="bacteria_with_decoys_csvConversion.py"

# Slurm submission defaults. Counts are samples (one SE file or one PE pair).
# Submission refuses a larger input set; raise MAX_SAMPLES explicitly if needed.
MAX_SAMPLES="40"
ARRAY_CONCURRENCY="8"

# Slurm account and notification email, applied to preparation, array, and final
# jobs. Leave the account empty to use your cluster's default; an empty email
# disables notifications. Fill in your own values here, not in the .sbatch file.
SLURM_ACCOUNT=""
SLURM_MAIL_USER=""

# Optional activation on compute nodes. Empty CONDA_SH uses the environment
# already activated when submitting. Otherwise fill in your own conda.sh path,
# e.g. /path/to/your/miniforge3/etc/profile.d/conda.sh (no username is supplied).
CONDA_SH=""
CONDA_ENV="bacteria-RNAseq-pipeline"
